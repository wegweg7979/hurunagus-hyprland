{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  // CPU power profile picker. The `power-profiles` provider already exists in
  // the shell (Menu.qml); nothing in the stock menu referenced it, so on a
  // machine without a battery there was no way to switch profiles.
  "system.power-profile": {"icon":"\uf0e7","label":"Power profile","provider":"power-profiles"},

  // Rebase this machine onto another Hurunagus variant, through hurubase
  // (github.com/wegweg7979/hurunagus-rebase) — the same command the image README
  // documents.  omarchy-hurunagus-rebase wraps it: hurubase's prompts read
  // /dev/tty, so it needs a real terminal, and the wrapper fetches a copy for a
  // machine that has none.  A rebase is a reboot, not an in-place change, and
  // the variant you are already running is refused by hurubase itself.
  "system.rebase": {"icon":"\uf021","label":"Rebase to another variant"},
  "system.rebase.hyprland": {"icon":"\uf17c","label":"Hyprland + Omarchy","description":"the flagship: Hyprland + Omarchy on Fedora bootc","when":"omarchy-cmd-present omarchy-hurunagus-rebase","action":"omarchy-hurunagus-rebase ghcr.io/wegweg7979/hurunagus-hyprland:latest"},
  "system.rebase.silverblue": {"icon":"\uf17c","label":"Silverblue + Niri + DMS","description":"the Silverblue line with the Niri session","when":"omarchy-cmd-present omarchy-hurunagus-rebase","action":"omarchy-hurunagus-rebase ghcr.io/wegweg7979/hurunagus-silverblue:latest"},
  "system.rebase.ublue": {"icon":"\uf17c","label":"uBlue + Niri + DMS","description":"the ublue image-template line with the Niri session","when":"omarchy-cmd-present omarchy-hurunagus-rebase","action":"omarchy-hurunagus-rebase ghcr.io/wegweg7979/hurunagus-ublue:latest"},
  "system.rebase.check": {"icon":"\uf00c","label":"Check the rebase plan (changes nothing)","description":"hurubase --check against the image this machine runs now","when":"omarchy-cmd-present omarchy-hurunagus-rebase","action":"omarchy-hurunagus-rebase --check"},

  // The full-screen retro weather board (dan.weatherboard, from the plugins
  // directory above). A panel has no bar slot to be clicked, so the menu row is
  // how it is reached on a fresh machine; the weather pill's own popup is the
  // bar widget beside the clock. Sits under Trigger with the other summon rows
  // (clipboard history, the speed tests). Bind a key to the same command
  // yourself if you want one -- Omarchy ships no binding for it, and
  // ~/.config/hypr/bindings.lua is personal overrides, so the payload must not
  // own it.
  "trigger.weather-board": {"icon":"\uf0c2","label":"Weather board","aliases":["weather-board","forecast"],"description":"the full-screen retro forecast, on the focused monitor","action":"omarchy-shell shell summon dan.weatherboard"},
}
